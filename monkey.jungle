project.manifest = manifest.xml

base.sourcePath = source
base.resourcePath = resources

# The launcher icon is the only per-device resource, and Garmin asks for six
# different sizes across the supported watches. Keeping it out of the shared
# path avoids a duplicate definition rather than relying on override precedence.
#
# Every device listed in manifest.xml needs a line here. A device with no line
# falls back to the shared path, finds no LauncherIcon, and fails to build —
# which is what `./build.sh export` is for.

# 40 px
fenix7.resourcePath = $(base.resourcePath);resources-icon40
fenix7pro.resourcePath = $(base.resourcePath);resources-icon40
fenix7pronowifi.resourcePath = $(base.resourcePath);resources-icon40
fenix7s.resourcePath = $(base.resourcePath);resources-icon40
fenix7spro.resourcePath = $(base.resourcePath);resources-icon40
fenix7x.resourcePath = $(base.resourcePath);resources-icon40
fenix7xpro.resourcePath = $(base.resourcePath);resources-icon40
fenix7xpronowifi.resourcePath = $(base.resourcePath);resources-icon40
fenix8solar47mm.resourcePath = $(base.resourcePath);resources-icon40
fenix8solar51mm.resourcePath = $(base.resourcePath);resources-icon40
fenix9prosolar47mm.resourcePath = $(base.resourcePath);resources-icon40
fenix9prosolar51mm.resourcePath = $(base.resourcePath);resources-icon40
fr955.resourcePath = $(base.resourcePath);resources-icon40

# 54 px
fr165.resourcePath = $(base.resourcePath);resources-icon54
fr165m.resourcePath = $(base.resourcePath);resources-icon54
fr170.resourcePath = $(base.resourcePath);resources-icon54
fr170m.resourcePath = $(base.resourcePath);resources-icon54
fr57042mm.resourcePath = $(base.resourcePath);resources-icon54
fr70.resourcePath = $(base.resourcePath);resources-icon54
venu441mm.resourcePath = $(base.resourcePath);resources-icon54
vivoactive6.resourcePath = $(base.resourcePath);resources-icon54

