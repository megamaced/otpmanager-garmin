<resources>
    <properties>
        <property id="serverUrl" type="string"></property>
        <property id="otpPassword" type="string"></property>

        <!-- Filled in by signing in, not by typing. They have no settings entry
             because there is nothing here worth typing: the login name and the
             app password both come back from Nextcloud's login flow, and the
             app keeps its copy in watch storage rather than here. What remains
             is the channel tools/bake-properties.py uses to configure a
             sideload, which has no settings screen at all. -->
        <property id="username" type="string"></property>
        <property id="appPassword" type="string"></property>

        <!-- Every credential, encrypted under the PIN. Written by the app when
             a PIN is set, or compiled in by tools/bake-properties.py. -->
        <property id="sealed" type="string"></property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.serverUrl" title="@Strings.SettingServerUrl" prompt="https://cloud.example.com">
            <settingConfig type="url"/>
        </setting>
        <setting propertyKey="@Properties.otpPassword" title="@Strings.SettingOtpPassword" prompt="@Strings.SettingOtpPasswordPrompt">
            <settingConfig type="password" maxLength="128"/>
        </setting>
    </settings>
</resources>
