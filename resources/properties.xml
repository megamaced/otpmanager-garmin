<resources>
    <properties>
        <property id="serverUrl" type="string"></property>
        <property id="username" type="string"></property>
        <property id="appPassword" type="string"></property>
        <property id="otpPassword" type="string"></property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.serverUrl" title="@Strings.SettingServerUrl" prompt="https://cloud.example.com">
            <settingConfig type="url"/>
        </setting>
        <setting propertyKey="@Properties.username" title="@Strings.SettingUsername">
            <settingConfig type="alphaNumeric" maxLength="64"/>
        </setting>
        <setting propertyKey="@Properties.appPassword" title="@Strings.SettingAppPassword">
            <settingConfig type="password" maxLength="128"/>
        </setting>
        <setting propertyKey="@Properties.otpPassword" title="@Strings.SettingOtpPassword">
            <settingConfig type="password" maxLength="128"/>
        </setting>
    </settings>
</resources>
